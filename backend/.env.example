# SQLite is the default for the hackathon MVP.
DATABASE_URL=sqlite:///./loop.db
FRONTEND_URL=http://localhost:3000
STORAGE_DIRECTORY=./storage

# Copy this file to .env and place your own key there. Never commit it.
# OPENAI_API_KEY=
LOOP_AGENT_MODEL=gpt-5.6
# High gives the agent more room to interpret ambiguous UI and accessibility signals.
# Use medium if you need faster, lower-cost exploratory runs.
LOOP_AGENT_REASONING_EFFORT=high
# Routine decisions use this faster profile. Loop escalates to the flagship
# profile above after ambiguity, an action failure, or new user guidance.
LOOP_AGENT_FAST_MODEL=gpt-5.6-terra
LOOP_AGENT_FAST_REASONING_EFFORT=medium
LOOP_AGENT_MAX_STEPS=12
LOOP_AGENT_MAX_REPORTED_ISSUES=3
LOOP_AGENT_MAX_OUTPUT_TOKENS=900
# A stronger reasoning model needs a little longer for difficult UI decisions.
# Loop still shows a live update after 6 seconds.
LOOP_AGENT_DECISION_TIMEOUT_SECONDS=45
LOOP_AGENT_DECISION_HEARTBEAT_SECONDS=6
LOOP_AGENT_USER_INPUT_TIMEOUT_SECONDS=600

# Set false during the local demo to show the real Chromium window.
PLAYWRIGHT_HEADLESS=true
